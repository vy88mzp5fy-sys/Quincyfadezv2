# Existing backend settings
MONGO_URL=mongodb://localhost:27017
DB_NAME=quincyfadez
CORS_ORIGINS=*

# Stripe server credentials — use test keys while developing.
# Never commit real secret keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Barber admin access.
# Store only the SHA-256 hash of the owner PIN, never the PIN itself.
# Example: echo -n "123456" | shasum -a 256
ADMIN_PIN_SHA256=replace_with_sha256_hash

# Admin session lifetime in hours. Default is 168 (7 days).
ADMIN_SESSION_HOURS=168
