{
  "expo": {
    "name": "QuincyFadez",
    "slug": "quincyfadez",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "quincyfadez",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050505"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quincyfadez.app"
    },
    "android": {
      "package": "com.quincyfadez.app"
    }
  }
}
