{
  "expo": {
    "name": "QuincyFadez",
    "slug": "quincyfadez",
    "owner": "quincyfadez",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "quincyfadez",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9bbf21b8-c05e-4e33-9002-37f05775cdd7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050505"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D6BD7A",
          "defaultChannel": "appointments"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quincyfadez.app"
    },
    "android": {
      "package": "com.quincyfadez.app"
    },
    "extra": {
      "eas": {
        "projectId": "9bbf21b8-c05e-4e33-9002-37f05775cdd7"
      }
    }
  }
}
